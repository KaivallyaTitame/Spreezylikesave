stage('Checkout Repo') {
  steps {
    checkout scm
  }
}

stage('Get App Version') {
  steps {
    script {
      env.APP_VERSION = sh(script: "node -p \"require('./package.json').version\"", returnStdout: true).trim()
      env.AAB_FILE = "spreezy-${APP_VERSION}.aab"
      env.VERSION_DIR = "spreezy-${APP_VERSION}"
    }
  }
}

stage('Download AAB from Nexus') {
  steps {
    withCredentials([usernamePassword(credentialsId: 'nexus_apk_credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
      sh '''
        curl -u $NEXUS_USER:$NEXUS_PASS -o $AAB_FILE "https://nexus.spreezy.in/repository/apk-release/${VERSION_DIR}/${AAB_FILE}"
      '''
    }
  }
}

stage('Upload to Google Play (Fastlane)') {
  steps {
    withCredentials([file(credentialsId: 'gplay-service-account', variable: 'GOOGLE_PLAY_JSON')]) {
      sh '''
        mkdir -p fastlane
        cat > fastlane/Fastfile <<EOF
        default_platform(:android)

        platform :android do
          lane :upload_internal do
            upload_to_play_store(
              track: "internal",
              aab: "${AAB_FILE}",
              json_key: "${GOOGLE_PLAY_JSON}",
              package_name: "com.spreezy.app",
              release_status: "draft",
              release_notes: [{
                language: "en-US",
                text: "Bug fixes and improvements."
              }]
            )
          end
        end
