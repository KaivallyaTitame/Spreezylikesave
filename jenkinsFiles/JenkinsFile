pipeline {
    agent {
        docker {
            image 'cypress/base:18.16.0'
        }
    }

    environment {
        PACKAGE_NAME = 'com.spreezy.app'
        TRACK = 'internal'
        RELEASE_NOTES = 'Bug fixes and improvements.'
    }

    stages {
        stage('Install Fastlane & Dependencies') {
            steps {
                sh '''
                    echo Installing dependencies...
                    apt-get update
        
                    # Ensure needed paths exist
                    mkdir -p /usr/share/man/man1
        
                    # Install system dependencies
                    apt-get install -y --no-install-recommends \
                      ruby-full \
                      curl \
                      unzip \
                      openjdk-17-jdk \
                      build-essential \
                      libffi-dev \
                      libssl-dev \
                      zlib1g-dev
        
                    # Configure broken packages, if any
                    dpkg --configure -a
        
                    # Install Fastlane
                    gem install fastlane -NV
                    echo "Fastlane version: $(fastlane --version)"
                '''
            }
        }



        stage('Download AAB from Nexus') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'nexus_apk_credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')
                ]) {
                    sh '''
                        echo Reading app version from package.json...
                        APP_VERSION=$(node -p "require('./package.json').version")
                        echo "App version: $APP_VERSION"
                        echo "$APP_VERSION" > .version.txt
                        VERSION_DIR="spreezy-$APP_VERSION"
                        AAB_NAME="spreezy-$APP_VERSION.aab"
                        curl -u $NEXUS_USER:$NEXUS_PASS -o $AAB_NAME "https://nexus.spreezy.in/repository/apk-release/${VERSION_DIR}/${AAB_NAME}"
                        echo "Downloaded AAB: $AAB_NAME"
                    '''
                }
            }
        }

        stage('Upload to Google Play (Fastlane)') {
            steps {
                withCredentials([
                    file(credentialsId: 'gplay-service-account', variable: 'GOOGLE_SERVICE_JSON')
                ]) {
                    sh '''
                        echo Preparing Fastfile for release...
                        APP_VERSION=$(cat .version.txt)
                        RELEASE_NAME="v$APP_VERSION"
                        AAB_FILE=$(ls *.aab)

                        mkdir -p android/fastlane

                        cat > android/fastlane/Fastfile <<EOF
                        default_platform(:android)

                        platform :android do
                          desc "Upload to internal track with release notes and version"
                          lane :internal do
                            upload_to_play_store(
                              json_key: "${GOOGLE_SERVICE_JSON}",
                              aab: "../$AAB_FILE",
                              track: "${TRACK}",
                              package_name: "${PACKAGE_NAME}",
                              release_status: "completed",
                              release_name: "${RELEASE_NAME}",
                              changelog: "${RELEASE_NOTES}"
                            )
                          end
                        end
                        EOF

                        cd android && fastlane internal
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ AAB uploaded to Internal Testing with release name and notes.'
        }
        failure {
            echo '❌ Upload failed. Check Fastlane logs for details.'
        }
    }
}
