


pipeline {
    agent {
        docker {
            image 'node:18-bullseye' // Includes npm & can install Java SDK and Gradle
            args '-u root:root'
            reuseNode true
        }
    }

    environment {
        GIT_URL = 'git@github.com:spreezy-tech/spreezy-frontend.git'
        GIT_BRANCH = 'feature-nandini'
        CREDENTIALS_ID = 'spreezy-frontend-keys'

        MYAPP_UPLOAD_STORE_FILE = credentials('MYAPP_UPLOAD_STORE_FILE')
        MYAPP_UPLOAD_KEY_ALIAS = credentials('MYAPP_UPLOAD_KEY_ALIAS')
        MYAPP_UPLOAD_STORE_PASSWORD = credentials('MYAPP_UPLOAD_STORE_PASSWORD')
        MYAPP_UPLOAD_KEY_PASSWORD = credentials('MYAPP_UPLOAD_KEY_PASSWORD')
        GOOGLE_PLAY_JSON_KEY = credentials('GOOGLE_PLAY_JSON_KEY')
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: env.GIT_BRANCH, credentialsId: env.CREDENTIALS_ID, url: env.GIT_URL
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'apt update && apt install -y openjdk-17-jdk zip unzip wget'
                sh 'npm install -g @angular/cli'
                sh 'npm install'
            }
        }

        stage('Build Angular App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Capacitor Sync') {
            steps {
                sh 'npx cap sync android'
            }
        }

        stage('Build AAB File') {
            steps {
                dir('android') {
                    sh './gradlew bundleRelease'
                }
            }
        }

        stage('Upload to Google Play (UAT)') {
            steps {
                script {
                    // Save JSON key to file
                    writeFile file: 'google-play-key.json', text: new String(Base64.decoder.decode(GOOGLE_PLAY_JSON_KEY))

                    // Upload AAB using fastlane
                    sh '''
                    apt install -y ruby ruby-dev build-essential
                    gem install fastlane -NV

                    cd android
                    fastlane supply --aab ./app/build/outputs/bundle/release/app-release.aab \
                        --package_name com.spreezy.app \
                        --track internal \
                        --json_key ../google-play-key.json \
                        --skip_upload_metadata true \
                        --skip_upload_images true \
                        --skip_upload_screenshots true
                    '''
                }
            }
        }

        stage('Notify Slack') {
            steps {
                slackSend channel: 'devops-jenkins-updates',
                          message: "✅ AAB built and uploaded to Internal Test track for Spreezy. Build #${env.BUILD_NUMBER} 🚀"
            }
        }
    }

    post {
        failure {
            slackSend channel: 'devops-jenkins-updates',
                      message: "❌ Build Failed: ${env.BUILD_URL}"
        }
    }
}
