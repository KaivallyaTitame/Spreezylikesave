pipeline {
    agent {
        docker {
            image 'cypress/base:18.16.0'
        }
    }

    environment {
        PACKAGE_NAME = 'com.spreezy.app'
        TRACK = 'internal'
        RELEASE_NOTES = 'Bug fixes and improvements.'
    }

    stages {
        stage('Setup Environment & Install Fastlane') {
            steps {
                sh '''
                    echo Installing dependencies...
                    apt-get update
                    apt-get install -y ruby-full curl unzip openjdk-17-jdk
                    gem install fastlane -NV
                    echo Fastlane installed: $(fastlane --version)
                '''
            }
        }

        stage('Download AAB from Nexus') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'nexus_apk_credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')
                ]) {
                    sh '''
                        echo Fetching app version from package.json...
                        APP_VERSION=$(node -p "require('./package.json').version")
                        echo "App version: $APP_VERSION"
                        VERSION_DIR="spreezy-$APP_VERSION"
                        AAB_NAME="spreezy-$APP_VERSION.aab"
                        curl -u $NEXUS_USER:$NEXUS_PASS -o $AAB_NAME "https://nexus.spreezy.in/repository/apk-release/${VERSION_DIR}/${AAB_NAME}"
                        echo "Downloaded $AAB_NAME"
                    '''
                }
            }
        }

        stage('Upload to Google Play Console (Fastlane)') {
            steps {
                withCredentials([
                    file(credentialsId: 'gplay-service-account', variable: 'GOOGLE_SERVICE_JSON')
                ]) {
                    sh '''
                        echo Creating Fastfile for upload...
                        mkdir -p android/fastlane
                        cat > android/fastlane/Fastfile <<EOF
                        default_platform(:android)

                        platform :android do
                          desc "Upload to internal track"
                          lane :internal do
                            upload_to_play_store(
                              track: '${TRACK}',
                              json_key: '${GOOGLE_SERVICE_JSON}',
                              aab: Dir["*.aab"].first,
                              package_name: '${PACKAGE_NAME}',
                              changelog: "${RELEASE_NOTES}"
                            )
                          end
                        end
                        EOF

                        echo Running Fastlane...
                        cd android && fastlane internal
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ AAB uploaded to Google Play Console using Fastlane.'
        }
        failure {
            echo '❌ Upload failed. Check Fastlane logs.'
        }
    }
}
