pipeline {
    agent {
        docker {
            image 'cypress/base:18.16.0'
            args '-u root'
        }
    }
    environment {
        PACKAGE_NAME = 'com.spreezy.app'
        TRACK = 'internal'
        CHANGELOG = 'Bug fixes and improvements.'
    }
    stages {
        stage('Install dependencies') {
            steps {
                sh '''
                    apt-get update && apt-get install -y curl gnupg2 git nodejs npm ruby ruby-dev build-essential
                    gem install fastlane -NV
                '''
            }
        }

        stage('Fetch & Upload AAB') {
            steps {
                withCredentials([
                    file(credentialsId: 'gplay-service-account', variable: 'GOOGLE_PLAY_JSON'),
                    usernamePassword(credentialsId: 'nexus_apk_credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')
                ]) {
                    sh '''
                        echo "Determining app version..."
                        APP_VERSION=$(git describe --tags --abbrev=0 2>/dev/null || echo "build-$(date +%Y%m%d%H%M)")
                        echo "Using version: $APP_VERSION"
                        VERSION_DIR="spreezy-$APP_VERSION"
                        AAB_NAME="spreezy-$APP_VERSION.aab"

                        echo "Downloading AAB from Nexus..."
                        curl -u $NEXUS_USER:$NEXUS_PASS -o $AAB_NAME "https://nexus.spreezy.in/repository/apk-release/${VERSION_DIR}/${AAB_NAME}"

                        echo "Setting up metadata directory for changelog..."
                        mkdir -p fastlane/metadata/android/en-US/changelogs
                        echo "$CHANGELOG" > fastlane/metadata/android/en-US/changelogs/$APP_VERSION.txt

                        echo "Creating Fastfile for upload..."
                        cat > fastlane/Fastfile <<EOF
                        default_platform(:android)

                        platform :android do
                          lane :upload_internal do
                            upload_to_play_store(
                              track: "${TRACK}",
                              aab: "${AAB_NAME}",
                              json_key: "${GOOGLE_PLAY_JSON}",
                              package_name: "${PACKAGE_NAME}",
                              release_status: "draft",
                              skip_upload_changelogs: false,
                              metadata_path: "fastlane/metadata"
                            )
                          end
                        end
EOF

                        echo "Uploading to Google Play Console via Fastlane..."
                        fastlane upload_internal
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo '❌ Upload failed.'
        }
        success {
            echo '✅ Upload pipeline completed successfully.'
        }
    }
}
